# Copy to .env and edit for your server
# cp .env.example .env

# Path mounted into the container as /data (used for any locally-cached eval outputs)
DATASET_DIR=/path/to/datasets

# HuggingFace cache directory (models + datasets)
HF_CACHE=/path/to/hf_cache

# HuggingFace token: required to load kjunh/GuideDog (auto-approve gated dataset)
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# OpenAI API key: required only if you want to compute the GPTScore metric
OPENAI_API_KEY=

# GPU visibility (default: all)
NVIDIA_VISIBLE_DEVICES=all
